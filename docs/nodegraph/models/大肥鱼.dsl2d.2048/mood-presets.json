{
  "schemaVersion": 1,
  "modelId": "大肥鱼.dsl2d.2048",
  "note": "神态预设草稿。取值范围来自大肥鱼.vtube.json 的输出范围；方向符号（尤其视线、眉、AngleZ）需在真模型上复核。摆动 = target ± amp，正弦，周期 periodMs，各参数周期互不成整数比以免同步。",
  "rules": {
    "enterMs": 1000,
    "exitMs": 600,
    "blink": "占用 ParamEyeLOpen/ParamEyeROpen 时，自动眨眼改为乘在预设值上（0..预设值），不能覆盖成全睁",
    "neverWrite": ["ParamMouthOpenY", "ParamAngleX", "ParamAngleY", "ParamAngleZ"]
  },
  "presets": {
    "妩媚": {
      "region": "face",
      "params": [
        {"id": "ParamEyeLOpen",  "range": [0, 1.5],  "target": 0.60, "amp": 0.05, "periodMs": 6100},
        {"id": "ParamEyeROpen",  "range": [0, 1.5],  "target": 0.55, "amp": 0.05, "periodMs": 6100},
        {"id": "EyeSmile",       "range": [0, 1],    "target": 0.45, "amp": 0.05, "periodMs": 5300},
        {"id": "LEyeSquint",     "range": [0, 1],    "target": 0.30, "amp": 0.05, "periodMs": 5300},
        {"id": "REyeSquint",     "range": [0, 1],    "target": 0.30, "amp": 0.05, "periodMs": 5300},
        {"id": "ParamEyeBallX",  "range": [-1, 1],   "target": 0.40, "amp": 0.15, "periodMs": 7300, "verifySign": true},
        {"id": "ParamEyeBallY",  "range": [-1, 1],   "target": -0.25,"amp": 0.10, "periodMs": 6700, "verifySign": true},
        {"id": "ParamBrowLY",    "range": [-1, 1],   "target": -0.30,"amp": 0.05, "periodMs": 8900, "verifySign": true},
        {"id": "ParamBrowRY",    "range": [-1, 1],   "target": -0.30,"amp": 0.05, "periodMs": 8900, "verifySign": true},
        {"id": "BrowInnerUp",    "range": [0, 1],    "target": 0.15, "amp": 0.05, "periodMs": 8900},
        {"id": "ParamMouthForm", "range": [-1, 1],   "target": 0.40, "amp": 0.05, "periodMs": 5900},
        {"id": "MouthSmile_L",   "range": [0, 1],    "target": 0.50, "amp": 0.08, "periodMs": 5900},
        {"id": "MouthSmile_R",   "range": [0, 1],    "target": 0.25, "amp": 0.05, "periodMs": 5900},
        {"id": "MouthX",         "range": [-1, 1],   "target": 0.20, "amp": 0.05, "periodMs": 5900, "verifySign": true},
        {"id": "AngleZ",         "range": [-30, 30], "target": 10,   "amp": 2,    "periodMs": 4100, "verifySign": true},
        {"id": "AngleX",         "range": [-30, 30], "target": 6,    "amp": 3,    "periodMs": 7900, "verifySign": true},
        {"id": "AngleY",         "range": [-30, 30], "target": -3,   "amp": 2,    "periodMs": 6300}
      ],
      "expressions": [{"name": "脸红", "on": true}],
      "signLinks": "ParamEyeBallX、MouthX、AngleX、AngleZ 偏向同一侧；MouthSmile_L 高于 _R 的一侧与之一致"
    }
  }
}
