  "purpose": "给大模型读的神态词典：参数含义 → 原子动作（AU）→ 组合算法 → 情绪配方示例。大模型只需挑 AU 和权重，bridge 负责换算成参数。",
  "sources": ["body-regions.json（可写性）", "大肥鱼.vtube.json（输出范围）"],
  "valuesAreDraft": true,
  "params": {
    "ParamEyeLOpen":  {"meaning": "左眼睁开程度", "range": [0, 1.5], "neutral": 1, "plus": "睁大", "minus": "闭合"},
    "ParamEyeROpen":  {"meaning": "右眼睁开程度", "range": [0, 1.5], "neutral": 1, "plus": "睁大", "minus": "闭合"},
    "EyeSmile":       {"meaning": "眼睛弯成笑眼", "range": [0, 1], "neutral": 0, "plus": "更弯"},
    "LEyeSquint":     {"meaning": "左下眼睑收紧（眯、审视、坏笑）", "range": [0, 1], "neutral": 0},
    "REyeSquint":     {"meaning": "右下眼睑收紧", "range": [0, 1], "neutral": 0},
    "ParamEyeBallX":  {"meaning": "视线左右", "range": [-1, 1], "neutral": 0, "verifySign": true},
    "ParamEyeBallY":  {"meaning": "视线上下", "range": [-1, 1], "neutral": 0, "plus": "向上", "verifySign": true},
    "ParamBrowLY":    {"meaning": "左眉高度", "range": [-1, 1], "neutral": 0, "plus": "上扬", "minus": "下压", "verifySign": true},
    "ParamBrowRY":    {"meaning": "右眉高度", "range": [-1, 1], "neutral": 0, "plus": "上扬", "minus": "下压", "verifySign": true},
    "BrowInnerUp":    {"meaning": "眉心上提（委屈、担忧、楚楚可怜）", "range": [0, 1], "neutral": 0},
    "ParamMouthForm": {"meaning": "嘴形整体", "range": [-1, 1], "neutral": 0, "plus": "上扬（笑）", "minus": "下撇（不满）"},
    "MouthSmile_L":   {"meaning": "左嘴角上扬", "range": [0, 1], "neutral": 0},
    "MouthSmile_R":   {"meaning": "右嘴角上扬", "range": [0, 1], "neutral": 0},
    "MouthX":         {"meaning": "嘴整体左右偏移", "range": [-1, 1], "neutral": 0, "verifySign": true},
    "Mouthpucker":    {"meaning": "嘟嘴", "range": [0, 1], "neutral": 0, "rangeFromModel": false},
    "CheeckPuff":     {"meaning": "鼓腮", "range": [0, 1], "neutral": 0, "rangeFromModel": false},
    "AngleX":         {"meaning": "头左右转", "range": [-30, 30], "neutral": 0, "verifySign": true},
    "AngleY":         {"meaning": "头上下（抬头/低头）", "range": [-30, 30], "neutral": 0, "plus": "抬头"},
    "AngleZ":         {"meaning": "头左右歪", "range": [-30, 30], "neutral": 0, "verifySign": true},
    "LeanInput":      {"meaning": "身体前倾（属于躯干模块）", "range": [-30, 0], "neutral": 0, "minus": "前倾", "rangeFromModel": false}
  },
  "neverWrite": {
    "ParamMouthOpenY": "口型同步专用",
    "ParamAngleX/Y/Z": "物理输出，写了会被覆盖；头部角度写 AngleX/Y/Z"
  },
  "actionUnits": {
    "eye_narrow":    {"名": "眯眼/半睁", "传达": "慵懒、放松、诱惑、困", "writes": {"ParamEyeLOpen": 0.5, "ParamEyeROpen": 0.5}, "opposes": "eye_wide"},
    "eye_wide":      {"名": "睁大眼", "传达": "惊讶、兴奋、害怕", "writes": {"ParamEyeLOpen": 1.4, "ParamEyeROpen": 1.4}, "opposes": "eye_narrow"},
    "eye_smile":     {"名": "笑眼", "传达": "开心、温柔、亲昵", "writes": {"EyeSmile": 1, "ParamEyeLOpen": 0.7, "ParamEyeROpen": 0.7}},
    "squint":        {"名": "下眼睑收紧", "传达": "坏笑、审视、生气、狡黠", "writes": {"LEyeSquint": 1, "REyeSquint": 1}},
    "gaze_side":     {"名": "斜睨", "传达": "调情、不屑、心虚", "lateral": true, "writes": {"ParamEyeBallX": 0.7}},
    "gaze_down":     {"名": "垂眸", "传达": "害羞、柔弱、思考、诱惑", "writes": {"ParamEyeBallY": -0.6}, "opposes": "gaze_up"},
    "gaze_up":       {"名": "上瞟", "传达": "回想、无辜、撒娇", "writes": {"ParamEyeBallY": 0.6}, "opposes": "gaze_down"},
    "brow_down":     {"名": "压眉", "传达": "生气、专注、魅惑（轻）", "writes": {"ParamBrowLY": -0.8, "ParamBrowRY": -0.8}, "opposes": "brow_up"},
    "brow_up":       {"名": "扬眉", "传达": "惊讶、得意、挑衅", "writes": {"ParamBrowLY": 0.8, "ParamBrowRY": 0.8}, "opposes": "brow_down"},
    "brow_inner_up": {"名": "眉心上提", "传达": "委屈、担忧、楚楚可怜", "writes": {"BrowInnerUp": 1}},
    "smile":         {"名": "微笑", "传达": "友好、开心", "writes": {"ParamMouthForm": 0.8, "MouthSmile_L": 0.6, "MouthSmile_R": 0.6}, "opposes": "frown"},
    "smirk":         {"名": "单侧挑嘴角", "传达": "坏笑、得意、调情、不屑", "lateral": true, "writes": {"MouthSmile_L": 0.7, "MouthSmile_R": 0.1, "MouthX": 0.3}, "mirror": {"MouthSmile_L": "MouthSmile_R"}},
    "frown":         {"名": "嘴角下撇", "传达": "不满、难过、生气", "writes": {"ParamMouthForm": -0.8}, "opposes": "smile"},
    "pout":          {"名": "嘟嘴", "传达": "撒娇、赌气", "writes": {"Mouthpucker": 1}},
    "cheek_puff":    {"名": "鼓腮", "传达": "生闷气、可爱", "writes": {"CheeckPuff": 1}},
    "head_tilt":     {"名": "歪头", "传达": "好奇、可爱、调情", "lateral": true, "writes": {"AngleZ": 15}},
    "head_turn":     {"名": "转头", "传达": "回避（负权重=转向对方）", "lateral": true, "writes": {"AngleX": 15}},
    "chin_down":     {"名": "低头/收下巴", "传达": "害羞、顺从、自下而上看人的魅惑", "writes": {"AngleY": -12}, "opposes": "chin_up"},
    "chin_up":       {"名": "抬下巴", "传达": "骄傲、挑衅、得意", "writes": {"AngleY": 12}, "opposes": "chin_down"},
    "lean_in":       {"名": "前倾", "传达": "亲近、感兴趣、压迫感", "region": "torso", "writes": {"LeanInput": -30}}
  },
  "expressionsAsAU": {
    "blush": {"名": "脸红", "传达": "害羞、心动、醉", "expression": "脸红"},
    "tears": {"名": "流泪", "传达": "难过、感动", "expression": "流泪"},
    "heart_eyes": {"名": "爱心眼", "传达": "着迷", "expression": "爱心眼"}
  },
  "algorithm": {
    "input": "{aus:{<AU>:权重0..1（head_turn 可为负）}, side:'L'|'R', energy:0..1, expressions:[名], enterMs?, holdMs?}",
    "steps": [
      "1. 侧向：lateral 的 AU 写入值乘 s（side=L 为 +1，R 为 -1）；有 mirror 的在 side=R 时交换左右参数。同一指令内所有 lateral AU 用同一个 side，眼神、嘴角、歪头自然朝同一侧。",
      "2. 叠加：对每个参数 value = neutral + Σ 权重 × (AU写入值 − neutral)，最后夹到 range。相反的 AU（opposes）同时给出会互相抵消，这是预期行为。",
      "3. 动态：每个参数绕 value 做正弦摆动，幅度 = 该参数量程 × 0.03 × (0.5 + energy)，周期从 [4100,5300,5900,6300,6700,7300,7900,8900] 按参数顺序取，互不成整数比；energy 越高摆得越大越快（周期 × (1.3 − 0.6·energy)）。",
      "4. 过渡：enterMs 默认 1000 渐入，退出 600 渐回 neutral。",
      "5. 眨眼：占用眼睛开合时，自动眨眼乘在 value 上（0..value），不覆盖。",
      "6. 不写 neverWrite；expressions 走表情层开关。"
    ],
    "reverse": "l2d_face_describe：读当前参数，按 AU 写入方向做非负最小二乘，返回『眯眼0.7、斜睨0.6…』，让大模型知道自己现在是什么表情。"
  },
