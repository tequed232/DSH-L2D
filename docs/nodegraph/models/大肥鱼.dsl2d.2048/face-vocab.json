    "不屑":  {"aus": {"gaze_side": 0.8, "eye_narrow": 0.6, "smirk": 0.5, "brow_down": 0.3, "chin_up": 0.4, "head_turn": 0.5}, "energy": 0.2, "why": "斜眼+转头避开+抬下巴"},
    "惊讶":  {"aus": {"eye_wide": 1, "brow_up": 1, "chin_up": 0.2}, "energy": 0.8, "why": "睁眼扬眉"},
    "生气":  {"aus": {"brow_down": 1, "squint": 0.6, "frown": 0.7, "chin_down": 0.3}, "energy": 0.7, "why": "压眉+眼睑收紧+嘴角下撇，低头瞪人"},
    "困倦":  {"aus": {"eye_narrow": 1, "gaze_down": 0.3, "brow_inner_up": 0.2, "head_tilt": 0.5, "chin_down": 0.4}, "energy": 0.1, "why": "眼皮沉+头歪，几乎不动"},
    "温柔":  {"aus": {"eye_smile": 0.7, "smile": 0.6, "head_tilt": 0.3, "brow_inner_up": 0.2}, "energy": 0.3, "why": "笑眼+微笑+轻歪头"},
    "撒娇":  {"aus": {"pout": 0.8, "gaze_up": 0.5, "brow_inner_up": 0.6, "head_tilt": 0.6, "chin_down": 0.3}, "expressions": ["脸红"], "energy": 0.6, "why": "嘟嘴+上瞟+眉心上提"}
  },
  "llmGuide": "想表达一种没在 recipes 里的神态时：先拆成『眼睛在干什么、视线看哪、眉毛、嘴角、头的姿态、要不要脸红』，每项挑一个 AU，用权重表示强弱（0.3 轻微、0.6 明显、0.9 强烈），energy 表示情绪激动程度。recipes 只是示例，可以混合，比如『害羞里带一点得意』= 两个配方按 0.7/0.3 加权。"
}
